      "port": 3300,
      "env": {
        "NEXT_DIST_DIR": ".next-viaapi",
        "NEXTAUTH_URL": "http://localhost:3300",
        "API_URL": "http://127.0.0.1:4100"
      }
    },
    {
      "name": "api-hourly-mock",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--filter",
        "@alarm/api",
        "dev"
      ],
      "port": 4110,
