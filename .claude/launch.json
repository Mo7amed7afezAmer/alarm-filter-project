{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--filter",
        "@alarm/api",
        "dev"
      ],
      "port": 4100
    },
    {
      "name": "web",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--filter",
        "@alarm/web",
        "exec",
        "next",
        "dev",
        "-H",
        "0.0.0.0"
      ],
      "port": 3000,
      "autoPort": true,
      "env": {
        "NEXT_DIST_DIR": ".next-preview"
      }
    },
    {
      "name": "web-hourly-mock",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--filter",
        "@alarm/web",
        "exec",
        "next",
        "dev",
        "-p",
        "3100"
      ],
      "port": 3100,
      "env": {
        "NEXT_DIST_DIR": ".next-mock",
        "NEXTAUTH_URL": "http://localhost:3100",
        "HOURLY_GMAIL_MOCK_DIR": "../../tests/fixtures"
      }
    },
    {
      "name": "web-via-api",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--filter",
